{
  "name": "kitsune-router-docs",
  "version": "1.0.0",
  "description": "Kitsune Router documentation. Your models. Your routes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "prebuild": "node ../scripts/check-installed-dependencies.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && npx wrangler pages deploy out --project-name=kitsune-router-docs --commit-dirty=true"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "next": "^16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

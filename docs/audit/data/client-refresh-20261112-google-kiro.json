      {
        "item": "CodeAssistServer flushes final SSE event at EOF",
        "decision": "Gateway SSE parsing already has independent terminal/fragment handling; no CLI parser copy or unmeasured speed claim."
      },
      {
        "item": "CLI terminal UI, extension installation, filesystem and model chooser fixes",
        "decision": "Client-local behavior outside the gateway wire profile; no blind import."
      }
    ]

# Kitsune Router environment contract
# This file reflects actual runtime usage in the current codebase.

# NOTE: you do not need to create a .env to get started. The CLI generates and
# persists these secrets on install (in the data dir: ~/.kitsune-router/secrets.json,
# or %APPDATA%\kitsune-router\secrets.json on Windows), and the Docker image
# provisions its own into the data volume. Copy this file to .env only when you
# want to override the generated values — anything set here wins over them.
# Keep existing JWT_SECRET, API_KEY_SECRET and MACHINE_ID_SALT values when
# migrating an installation. Branding changes are not secret rotations.
#
# Required — JWT_SECRET must be a strong random value (min 32 chars). There is
# no fallback; without one (generated or supplied) dashboard login fails 500.
# Generate with: openssl rand -hex 32
# Optional rotation: keep the previous secret here during key rotation so that
# existing sessions signed with the old secret remain valid until they expire.
# JWT_SECRET_OLD=previous-secret-min-32-chars-keep-until-rotation-complete
JWT_SECRET_OLD=
INITIAL_PASSWORD=12345678
DATA_DIR=/var/lib/kitsune-router
# Default-path installations migrate stopped legacy state automatically.
# Select a source explicitly if more than one legacy installation is found:
# KITSUNE_ROUTER_MIGRATE_FROM=/absolute/path/to/old-state
# Start a separate fresh default-path installation instead:
# KITSUNE_ROUTER_MIGRATION=skip

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Aggregate bounded phase timings; no request payloads or identity labels.
KITSUNE_ROUTER_REQUEST_TIMING=0
KITSUNE_ROUTER_SHUTDOWN_DEADLINE_MS=15000
KITSUNE_ROUTER_HTTP_KEEP_ALIVE_MS=65000
# Native SQLite supports shared workers; sql.js requires explicit exclusive ownership.
KITSUNE_ROUTER_SQLJS_SINGLE_PROCESS=false
AUTH_COOKIE_SECURE=false
# Enforce Bearer API key on /v1/* (one-way override: true forces enforcement
# even if the dashboard toggle is off; anything else leaves the toggle in charge)
REQUIRE_API_KEY=false

# Public base URL for SSO callbacks (optional)
# Use the externally reachable URL of this instance for OIDC/SAML callbacks.
# The legacy cloud-sync scheduler and /api/sync/cloud route were removed.
BASE_URL=http://localhost:20128
# NEXT_PUBLIC_BASE_URL=http://localhost:20128
# Optional analytics for an operator-owned property; off unless configured.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-YOUR-PROPERTY-ID

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=kitsune-router

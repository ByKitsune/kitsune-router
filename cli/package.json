{
  "name": "@bykitsune/router",
  "version": "1.0.5",
  "description": "Kitsune Router CLI and provider-neutral AI gateway. Your models. Your routes.",
  "bin": {
    "kitsune-router": "./cli.js"
  },
  "files": [
    "cli.js",
    "src",
    "hooks",
    "app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch cli.js",
    "prebuild": "node ../scripts/check-installed-dependencies.mjs",
    "build": "node scripts/build-cli.js",
    "pack:cli": "npm run build && npm pack --pack-destination ..",
    "publish:cli": "npm run build && npm publish",
    "postinstall": "node hooks/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "node-machine-id": "^1.1.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "comment_sqlite": "sql.js + better-sqlite3 are installed into the resolved DATA_DIR/runtime by hooks/postinstall.js. Legacy state is migrated before setup.",
  "comment_systray": "systray2 is NOT bundled here. It is lazy-installed into runtime directories by hooks/postinstall.js.",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "kitsune-router",
    "cli",
    "gateway",
    "proxy",
    "ai",
    "api",
    "llm-router"
  ],
  "license": "MIT",
  "author": "ByKitsune",
  "homepage": "https://github.com/ByKitsune/kitsune-router#readme",
  "bugs": "https://github.com/ByKitsune/kitsune-router/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByKitsune/kitsune-router.git"
  }
}

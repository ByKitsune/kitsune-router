{
  "name": "@joyccn/zenrouter",
  "version": "0.9.13",
  "description": "ZenRouter CLI - Serene AI Gateway & Intelligent Routing Engine",
  "bin": {
    "zenrouter": "./cli.js"
  },
  "files": [
    "cli.js",
    "src",
    "hooks",
    "app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch cli.js",
    "prebuild": "node ../scripts/check-installed-dependencies.mjs",
    "build": "node scripts/build-cli.js",
    "pack:cli": "npm run build && npm pack --pack-destination ..",
    "publish:cli": "npm run build && npm publish",
    "postinstall": "node hooks/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "node-machine-id": "^1.1.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "comment_sqlite": "sql.js + better-sqlite3 are NOT bundled here. They are installed into runtime directories (~/.zenrouter/runtime or ~/.9router/runtime) by hooks/postinstall.js.",
  "comment_systray": "systray2 is NOT bundled here. It is lazy-installed into runtime directories by hooks/postinstall.js.",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "zenrouter",
    "cli",
    "gateway",
    "proxy",
    "ai",
    "api",
    "llm-router"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenRouter/ZenRouter.git"
  }
}
